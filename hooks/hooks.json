{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${CLAUDE_PLUGIN_ROOT}/scripts/gen-index.sh\"",
            "if": "Write(**/wiki/**)"
          },
          {
            "type": "command",
            "command": "/bin/bash \"${CLAUDE_PLUGIN_ROOT}/scripts/gen-index.sh\"",
            "if": "Edit(**/wiki/**)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${CLAUDE_PLUGIN_ROOT}/scripts/lint.sh\""
          }
        ]
      }
    ]
  }
}
